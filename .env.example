# Docker FaaS Configuration Example
# Copy this file to .env and update with your values

# Note: This file contains SERVER configuration for the Docker FaaS gateway.
# For CLIENT configuration (faas-cli, SDKs), use standard OpenFaaS environment variables:
#   OPENFAAS_URL=http://localhost:8080  # Preferred (OpenFaaS standard)
#   OPENFAAS_USERNAME=admin             # For Basic Auth
#   OPENFAAS_PASSWORD=admin             # For Basic Auth
#   OPENFAAS_TOKEN=<token>              # For Bearer Token auth

# Gateway Configuration
GATEWAY_PORT=8080
METRICS_PORT=9090
CORS_ALLOWED_ORIGINS=

# Docker Configuration
DOCKER_HOST=
# FUNCTIONS_NETWORK also serves as this gateway's OWNERSHIP identity for function
# containers on the Docker daemon. Explicitly different ownership labels are
# always ignored; strict mode below also ignores unlabeled legacy containers.
# Shared-daemon deployments require DISTINCT networks and disjoint function names.
# WARNING: changing this on an existing deployment makes the gateway treat its
# previously-created labeled containers as foreign (they are left alone, not
# reclaimed) — drain/redeploy functions if you must rename the network.
FUNCTIONS_NETWORK=docker-faas-net

# Strict container ownership (opt-in). When true, per-function operations
# (reclaim, scale, routing, replica counting) ignore containers with NO
# gateway-ownership label, in addition to always ignoring another gateway's
# containers. Enable ONLY on a Docker daemon SHARED by multiple docker-faas
# instances. Upgrade sequence: leave this false, redeploy functions so their
# containers gain the ownership label, verify the labels, then enable strict mode
# and restart. Labels are immutable; strict mode intentionally refuses to adopt
# or delete an unlabeled container that already occupies a desired name.
# NOTE: even with this on, two gateways cannot run a SAME-NAMED function on one
# daemon (container names are globally <function>-<replica>); use disjoint
# function names per gateway. A single gateway per daemon needs none of this.
# FAAS_STRICT_CONTAINER_OWNERSHIP=false
GATEWAY_CONTAINER_NAME=
DEBUG_BIND_ADDRESS=127.0.0.1

# Async callback SSRF guard (opt-in). When true, an async X-Callback-Url whose
# host is/resolves to a loopback/link-local/private/cloud-metadata address is
# rejected 400. Default false preserves OpenFaaS behavior (any callback host
# allowed, including legitimate internal services). Not a substitute for network
# egress controls; best-effort against DNS rebinding.
# FAAS_ASYNC_CALLBACK_BLOCK_INTERNAL=false

# Authentication
AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASSWORD=admin  # CHANGE THIS IN PRODUCTION!
REQUIRE_AUTH_FOR_FUNCTIONS=true  # Set false for OpenFaaS compatibility
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW=1m
AUTH_TOKEN_TTL=30m

# Database
STATE_DB_PATH=docker-faas.db

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# Timeouts (in Go duration format: 30s, 1m, 1h)
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s
EXEC_TIMEOUT=60s

# Scaling
DEFAULT_REPLICAS=1
MAX_REPLICAS=10

# Idle scale-to-zero (provider side; policy is owned by the AIDrivenMES control
# plane). The reconciler ships OFF; enable it and configure the idle window.
IDLE_SCALE_TO_ZERO_ENABLED=false
IDLE_RECONCILE_SECONDS=30
IDLE_DURATION_SECONDS=300
IDLE_WARM_MIN_REPLICAS=0

# Activity-lease authentication (CV-06 / SZ-12). ISOLATED HMAC secret shared with
# the AIDrivenMES control plane used to verify inbound activity-lease requests and
# sign the responses. MUST be a dedicated secret — NOT the app DB secret, never
# hardcoded. Provide it directly, or (preferred) via a mounted file whose path is
# FAAS_ACTIVITY_LEASE_SECRET_FILE (the file form wins). When
# IDLE_SCALE_TO_ZERO_ENABLED=true this MUST be set or the gateway fails to start
# (fail-closed); while unset, the /system/scale/activity-lease endpoint rejects
# every request with 503.
FAAS_ACTIVITY_LEASE_SECRET=
# FAAS_ACTIVITY_LEASE_SECRET_FILE=/run/secrets/faas_activity_lease_secret

# Activity-lease transport hardening (RT-214). Optional; sensible defaults apply.
# Secret rotation overlap: while set, requests signed with EITHER the active or
# the previous secret verify; responses are always signed with the active secret.
# Remove after the control plane has rolled over.
# FAAS_ACTIVITY_LEASE_SECRET_PREVIOUS=
# FAAS_ACTIVITY_LEASE_SECRET_PREVIOUS_FILE=/run/secrets/faas_activity_lease_secret_previous
# Max |now - issued_at| accepted on a signed request (Go duration). 0 disables the
# freshness check (discouraged; logged). Default 2m.
# FAAS_ACTIVITY_LEASE_MAX_SKEW=2m
# Max activity-lease request body in bytes (<=0 → 64 KiB default; cannot be disabled).
# FAAS_ACTIVITY_LEASE_BODY_LIMIT=65536
# Nonce replay-cache capacity (<=0 → 65536 default). At capacity the oldest entry
# is evicted and the request is still accepted (never rejected). Size at
# (leased functions × renewals per replay window) with headroom.
# FAAS_ACTIVITY_LEASE_REPLAY_CAP=65536

# Metrics
METRICS_ENABLED=true

# Build History
BUILD_HISTORY_LIMIT=100
BUILD_HISTORY_RETENTION=24h
BUILD_OUTPUT_LIMIT=204800
